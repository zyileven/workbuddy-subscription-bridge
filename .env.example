# Copy this file to .env on the deployment computer.
# public enables the ngrok service; leave empty for a loopback-only deployment.
COMPOSE_PROFILES=public

# Required when the public profile is enabled. This is an ngrok agent authtoken,
# NOT an ngrok API key, OpenAI token, or WorkBuddy bridge key.
NGROK_AUTHTOKEN=

# Optional: an HTTPS endpoint URL available to your ngrok account.
# Leave empty to let ngrok choose; copy the resulting URL from ngrok logs.
# Example: https://your-domain.ngrok.app
NGROK_URL=
